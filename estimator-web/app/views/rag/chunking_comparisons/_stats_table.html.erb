<table id="stats-table">
  <thead>
    <tr>
      <th>Estrategia</th>
      <th class="num">Chunks</th>
      <th class="num">Mín</th>
      <th class="num">p50</th>
      <th class="num">p95</th>
      <th class="num">Máx</th>
      <th class="num" title="Menos de 20 tokens">Huérfanos</th>
      <th class="num" title="Más de 800 tokens">Obesos</th>
      <th class="num">Llamadas extra</th>
      <th class="num">Segundos</th>
    </tr>
  </thead>
  <tbody>
    <% response.strategy_names.each do |name| %>
      <% stats = response.stats_for(name) %>
      <% distribution = stats.token_distribution %>
      <tr id="stats-<%= name %>">
        <td><strong><%= Rag::Strategy.label_for(name) %></strong></td>
        <td class="num"><%= stats.n_chunks %></td>
        <td class="num"><%= distribution.min %></td>
        <td class="num"><%= number_with_precision(distribution.p50, precision: 1, separator: ",") %></td>
        <td class="num"><%= number_with_precision(distribution.p95, precision: 1, separator: ",") %></td>
        <td class="num"><%= distribution.max %></td>
        <td class="num"><%= stats.n_orphan_chunks %><%= " ⚠".html_safe if stats.orphans? %></td>
        <td class="num"><%= stats.n_obese_chunks %><%= " ⚠".html_safe if stats.obese? %></td>
        <td class="num"><%= stats.extra_api_calls %></td>
        <td class="num"><%= number_with_precision(stats.ingestion_seconds, precision: 2, separator: ",") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<p class="hint">Huérfanos: chunks de menos de 20 tokens. Obesos: más de 800 tokens. Los percentiles son de tokens por chunk.</p>
