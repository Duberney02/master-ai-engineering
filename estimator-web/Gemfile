source "https://rubygems.org"

gem "rails", "~> 8.1.4"
gem "puma", ">= 5.0"
# Cliente HTTP de la API del estimador.
gem "faraday", "~> 2.9"
# Envío multipart (transcripción y adjuntos PDF/Word) a la API de sesiones.
gem "faraday-multipart", "~> 1.0"
# Historial del Chunking Lab (PostgreSQL). El resto del cliente sigue sin estado propio.
gem "pg", "~> 1.5"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

group :development, :test do
  # Lint (estilo omakase de Rails).
  gem "rubocop-rails-omakase", require: false
end

group :test do
  # Dobles HTTP: las pruebas nunca llaman a la API real.
  gem "webmock", "~> 3.23"
end
