<% content_for :title, "Historial · Chunking Lab" %>
<h1>Chunking Lab · historial</h1>
<p><a class="button" href="<%= new_rag_chunking_comparison_path %>">Nueva comparación</a></p>

<% if @comparisons.empty? %>
  <div class="card" id="lab-history-empty">Todavía no hay comparaciones guardadas. <a href="<%= new_rag_chunking_comparison_path %>">Crea la primera</a>.</div>
<% else %>
  <div class="card">
    <table id="lab-history">
      <thead>
        <tr><th>Fecha</th><th>Estrategias</th><th class="num">Consultas</th><th class="num">Coste</th><th class="num">Duración</th><th></th></tr>
      </thead>
      <tbody>
        <% @comparisons.each do |comparison| %>
          <tr>
            <td><%= format_time(comparison.created_at.utc.iso8601) %></td>
            <td><%= comparison.strategy_labels.join(", ") %></td>
            <td class="num"><%= comparison.queries.size %></td>
            <td class="num"><%= format_usd(comparison.total_cost_usd) %></td>
            <td class="num"><%= comparison.duration_seconds ? "#{comparison.duration_seconds} s" : "—" %></td>
            <td><a href="<%= rag_chunking_comparison_path(comparison) %>">Ver</a></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
