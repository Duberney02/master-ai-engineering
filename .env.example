# Variables del Compose raíz (docker-compose.yml). Las claves del proveedor LLM van en
# estimador-cag/.env, no aquí. Copia este archivo a `.env` para personalizarlas.

# Contraseña de PostgreSQL (valor de desarrollo por defecto: estimator-dev).
POSTGRES_PASSWORD=estimator-dev

# Secreto de sesión de Rails. Genera uno propio fuera de desarrollo: openssl rand -hex 64
# SECRET_KEY_BASE=
