<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Estimador de proyectos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <style>
      :root { --fg:#1f2933; --muted:#616e7c; --line:#d9e2ec; --bg:#f5f7fa; --card:#fff; --accent:#1d4ed8; --warn:#92400e; --warn-bg:#fef3c7; --err:#991b1b; --err-bg:#fee2e2; }
      @media (prefers-color-scheme: dark) { :root { --fg:#e4e7eb; --muted:#9aa5b1; --line:#3e4c59; --bg:#1f2933; --card:#27323d; --accent:#7aa2ff; --warn:#fcd34d; --warn-bg:#3b2f0b; --err:#fecaca; --err-bg:#4c1d1d; } }
      * { box-sizing: border-box; }
      body { margin:0; font:16px/1.5 system-ui, sans-serif; color:var(--fg); background:var(--bg); }
      header { background:var(--card); border-bottom:1px solid var(--line); }
      nav { max-width:80rem; margin:0 auto; padding:1rem; display:flex; align-items:center; gap:.25rem; }
      .layout { display:grid; grid-template-columns:21rem minmax(0,1fr); max-width:80rem; margin:0 auto; }
      .layout.no-sidebar, .layout.collapsed { grid-template-columns:minmax(0,1fr); }
      .layout.collapsed aside { display:none; }
      main { padding:1rem; min-width:0; }
      aside { padding:1rem; border-right:1px solid var(--line); background:var(--card); font-size:.9rem; }
      aside h2 { margin-top:0; font-size:1.2rem; }
      aside h3 { font-size:1rem; margin-bottom:.25rem; }
      aside textarea { min-height:0; font:.8rem/1.4 ui-monospace, monospace; resize:vertical; }
      aside .example { margin:.5rem 0; }
      dl { margin:0; } dl div { display:flex; justify-content:space-between; gap:.5rem; padding:.25rem 0; border-bottom:1px solid var(--line); }
      dt { color:var(--muted); } dd { margin:0; font-weight:600; text-align:right; }
      #sidebar-toggle { margin:0 1rem 0 0; padding:.2rem .6rem; color:var(--accent); background:transparent; border:1px solid var(--line); }
      @media (max-width:800px) { .layout { grid-template-columns:minmax(0,1fr); } aside { border-right:0; border-bottom:1px solid var(--line); } }
      nav a { margin-right:1.25rem; color:var(--accent); text-decoration:none; font-weight:600; }
      h1 { margin-top:0; }
      main a { color:var(--accent); }
      .card { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:1rem 1.25rem; margin-bottom:1rem; }
      label { display:block; font-weight:600; margin:.75rem 0 .25rem; }
      textarea, select, input[type=file] { width:100%; padding:.5rem; font:inherit; color:inherit; background:var(--bg); border:1px solid var(--line); border-radius:6px; }
      textarea { min-height:12rem; resize:vertical; }
      .row { display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(12rem,1fr)); }
      .hint, .counter { color:var(--muted); font-size:.875rem; }
      button { margin-top:1rem; padding:.6rem 1.4rem; font:inherit; font-weight:600; color:#fff; background:var(--accent); border:0; border-radius:6px; cursor:pointer; }
      button[disabled] { opacity:.6; cursor:progress; }
      .alert { padding:.75rem 1rem; border-radius:6px; margin-bottom:1rem; }
      .alert.error { color:var(--err); background:var(--err-bg); }
      .alert.warn { color:var(--warn); background:var(--warn-bg); }
      .metrics { display:grid; gap:1rem; grid-template-columns:repeat(auto-fit,minmax(10rem,1fr)); margin:1rem 0; }
      .metric { border:1px solid var(--line); border-radius:8px; padding:.75rem 1rem; }
      .metric span { display:block; color:var(--muted); font-size:.875rem; }
      .metric strong { font-size:1.4rem; }
      table { width:100%; border-collapse:collapse; }
      th, td { text-align:left; padding:.5rem; border-bottom:1px solid var(--line); vertical-align:top; }
      td.num, th.num { text-align:right; white-space:nowrap; }
      .meta { color:var(--muted); font-size:.875rem; }
      #loading { display:none; align-items:center; gap:.75rem; margin-top:1rem; }
      #loading.active { display:flex; }
      .spinner { width:1.25rem; height:1.25rem; border:3px solid var(--line); border-top-color:var(--accent); border-radius:50%; animation:spin 1s linear infinite; }
      @keyframes spin { to { transform:rotate(360deg); } }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <% if @sidebar %><button type="button" id="sidebar-toggle" aria-controls="sidebar" aria-expanded="true" title="Mostrar u ocultar el contexto del prompt">«</button><% end %>
        <a href="<%= root_path %>">Nueva estimación</a>
        <a href="<%= estimations_path %>">Historial</a>
      </nav>
    </header>
    <div class="layout<%= " no-sidebar" unless @sidebar %>" id="layout">
      <% if @sidebar %>
        <aside id="sidebar"><%= render "estimations/sidebar" %></aside>
      <% end %>
      <main>
        <%= yield %>
      </main>
    </div>
    <% if @sidebar %>
      <script>
        (function () {
          var toggle = document.getElementById("sidebar-toggle");
          var layout = document.getElementById("layout");
          toggle.addEventListener("click", function () {
            var collapsed = layout.classList.toggle("collapsed");
            toggle.textContent = collapsed ? "»" : "«";
            toggle.setAttribute("aria-expanded", String(!collapsed));
          });
        })();
      </script>
    <% end %>
  </body>
</html>
