# --- Proveedor de LLM (elige uno y completa SOLO su clave) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=DEBUG

# Opcional: lista (separada por comas) de modelos que una solicitud puede pedir
# con el campo "model". Vacío = cualquier nombre de modelo con formato válido.
# ALLOWED_MODELS=gpt-4o-mini,gpt-4o,claude-haiku-4-5

# Timeout por intento del SDK y reintentos (sin duplicación en otra capa).
LLM_TIMEOUT=60
LLM_RETRIES=2
# Fallback opt-in: configurar ambos y la clave del proveedor alternativo.
# FALLBACK_PROVIDER=anthropic
# FALLBACK_MODEL=claude-haiku-4-5

# Sin REDIS_URL, caché desactivada. Compose usa Redis interno.
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400
CACHE_TIMEOUT=0.5

# Tarifas consultadas el 2026-09-29: USD por millón de tokens de texto.
# API directa, nivel Standard, entrada sin cachear y contexto corto cuando aplique.
# Selección: modelos del proyecto y familias actuales; no es el catálogo completo.
# OpenAI: https://developers.openai.com/api/docs/pricing
# GPT-4o mini: https://developers.openai.com/api/docs/models/gpt-4o-mini
# GPT-4o: https://developers.openai.com/api/docs/models/gpt-4o
# Anthropic: https://platform.claude.com/docs/en/about-claude/pricing
# IDs Anthropic: https://platform.claude.com/docs/en/models/overview
# No contempla Batch/Flex/Fast, caché del proveedor, contexto largo ni recargos regionales.
# Ajustar a las tarifas contratadas; registrar un precio no habilita compatibilidad SDK.
# Las claves deben coincidir con el modelo devuelto por el SDK (incluidos snapshots).
# Modelo no incluido o MODEL_PRICES={} => coste desconocido (null).
MODEL_PRICES={"gpt-4o-mini":{"input":0.15,"output":0.60},"gpt-4o-mini-2024-07-18":{"input":0.15,"output":0.60},"gpt-4o":{"input":2.50,"output":10.00},"gpt-4o-2024-08-06":{"input":2.50,"output":10.00},"gpt-4o-2024-11-20":{"input":2.50,"output":10.00},"gpt-6-astra":{"input":10.00,"output":50.00},"gpt-6-sol":{"input":2.00,"output":10.00},"gpt-6-luna":{"input":0.10,"output":0.50},"claude-haiku-4-5":{"input":1.00,"output":5.00},"claude-haiku-4-5-20251001":{"input":1.00,"output":5.00},"claude-sonnet-5-5":{"input":2.00,"output":10.00},"claude-opus-5-5":{"input":4.00,"output":20.00},"claude-fable-5-1":{"input":10.00,"output":50.00}}

# Solo Streamlit necesita esta URL; no necesita claves LLM.
ESTIMATOR_API_BASE_URL=http://localhost:8000
