<% content_for :title, "Ajustes · Estimador de proyectos" %>
<h1>Ajustes del servicio IA</h1>

<% if @catalog.nil? %>
  <div class="card" id="settings-unavailable">
    <p>No se puede mostrar la configuración ahora mismo. <a href="<%= ai_settings_path %>">Reintentar</a>.</p>
  </div>
<% else %>
  <p class="hint">
    Los modelos se cambian en tiempo de ejecución: el cambio aplica desde la siguiente solicitud, sin reiniciar el servicio ni tocar <code>.env</code>.
    Un campo vacío usa el valor por defecto. Solo aparecen los modelos de los proveedores con clave configurada.
  </p>

  <%= form_with url: ai_settings_path, method: :patch, id: "settings-form" do %>
    <div class="card">
      <table id="models-table">
        <thead>
          <tr><th>Uso</th><th>Por defecto</th><th>Vigente</th><th>Modelo</th></tr>
        </thead>
        <tbody>
          <% @catalog.model_configs.each do |config| %>
            <tr id="knob-<%= config.key %>">
              <td>
                <strong><%= config.label %></strong>
                <div class="meta"><%= config.description %></div>
              </td>
              <td><code><%= config.default.presence || "—" %></code></td>
              <td>
                <code><%= config.effective.presence || "—" %></code>
                <% if config.overridden %><span class="badge parent" title="Hay un override en tiempo de ejecución">override</span><% end %>
              </td>
              <td>
                <% options = @catalog.options_for(config) %>
                <%= select_tag "models[#{config.key}]",
                      options_for_select([ [ "Valor por defecto#{config.default.present? ? " (#{config.default})" : ""}", "" ] ] + options.map { |model| [ model, model ] },
                                         (config.effective if config.overridden)),
                      id: "models_#{config.key}", "aria-label": config.label %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <button type="submit">Guardar</button>
    </div>
  <% end %>

  <div class="card" id="embedding-model">
    <h2>Modelo de embeddings</h2>
    <p><code><%= @catalog.embedding_model %></code></p>
    <p class="meta"><%= @catalog.embedding_model_note.presence || "Solo lectura: cambiarlo invalidaría todos los vectores guardados." %></p>
  </div>
<% end %>
