# Configuración del SERVIDOR (API). El cliente Streamlit usa .env.client.example.
# Nunca pongas claves reales en este archivo de ejemplo.

# --- Proveedor y modelo primario (elige uno y completa SOLO las claves necesarias) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelo secundario opcional (fallback). Formato `proveedor/modelo` o nombre inferible
# (gpt-*, o1/o3/o4*, claude-*). Requiere la clave de SU proveedor. Vacío = sin fallback.
# LLM_FALLBACK_MODEL=anthropic/claude-haiku-4-5

# Opcional: modelos que una solicitud puede pedir con el campo "model" (separados por
# comas). Cada uno debe tener la clave de su proveedor. Vacío = sin restricción.
# ALLOWED_MODELS=gpt-4o-mini,gpt-4o

# --- Timeouts y reintentos del wrapper LLM ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
# Espera máxima de una petición idéntica concurrente por el resultado de otra.
LLM_INFLIGHT_WAIT_SECONDS=120
# Precios adicionales o actualizados (USD por millón de tokens):
# LLM_PRICING_OVERRIDES={"openai/gpt-4.1-nano": {"input": 0.10, "output": 0.40}}

# --- Caché Redis (coincidencia exacta) ---
CACHE_ENABLED=true
# En Docker Compose se sobrescribe con redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400
CACHE_PREFIX=estimador-cag
REDIS_TIMEOUT_SECONDS=0.5
CACHE_RETRY_AFTER_SECONDS=15

# --- SSE ---
SSE_HEARTBEAT_SECONDS=15

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=DEBUG
# auto = JSON si APP_ENV=production; console = legible; json = una línea JSON por evento.
LOG_FORMAT=auto
