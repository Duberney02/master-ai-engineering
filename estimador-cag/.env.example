# --- Proveedor de LLM (elige uno y completa SOLO su clave) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Aplicación ---
# APP_ENV: development | test | staging | production (production activa los logs JSON).
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL. Cualquier otro valor impide arrancar.
APP_ENV=development
LOG_LEVEL=DEBUG

# Opcional: lista (separada por comas) de modelos que una solicitud puede pedir
# con el campo "model". Vacío = cualquier nombre de modelo con formato válido.
# ALLOWED_MODELS=gpt-4o-mini,gpt-4o,claude-haiku-4-5

# Timeout por intento del SDK y reintentos (sin duplicación en otra capa).
LLM_TIMEOUT=60
LLM_RETRIES=2
# Fallback opt-in: configurar ambos y la clave del proveedor alternativo.
# FALLBACK_PROVIDER=anthropic
# FALLBACK_MODEL=claude-haiku-4-5

# Sin REDIS_URL, cachés desactivadas. Compose usa Redis Stack (RediSearch) interno.
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400
CACHE_TIMEOUT=0.5

# Tarifas consultadas el 2026-09-29: USD por millón de tokens de texto.
# API directa, nivel Standard, entrada sin cachear y contexto corto cuando aplique.
# Selección: modelos del proyecto y familias actuales; no es el catálogo completo.
# OpenAI: https://developers.openai.com/api/docs/pricing
# GPT-4o mini: https://developers.openai.com/api/docs/models/gpt-4o-mini
# GPT-4o: https://developers.openai.com/api/docs/models/gpt-4o
# Anthropic: https://platform.claude.com/docs/en/about-claude/pricing
# IDs Anthropic: https://platform.claude.com/docs/en/models/overview
# No contempla Batch/Flex/Fast, caché del proveedor, contexto largo ni recargos regionales.
# Ajustar a las tarifas contratadas; registrar un precio no habilita compatibilidad SDK.
# Las claves deben coincidir con el modelo devuelto por el SDK (incluidos snapshots).
# Modelo no incluido o MODEL_PRICES={} => coste desconocido (null).
MODEL_PRICES={"gpt-4o-mini":{"input":0.15,"output":0.60},"gpt-4o-mini-2024-07-18":{"input":0.15,"output":0.60},"gpt-4o":{"input":2.50,"output":10.00},"gpt-4o-2024-08-06":{"input":2.50,"output":10.00},"gpt-4o-2024-11-20":{"input":2.50,"output":10.00},"gpt-6-astra":{"input":10.00,"output":50.00},"gpt-6-sol":{"input":2.00,"output":10.00},"gpt-6-luna":{"input":0.10,"output":0.50},"claude-haiku-4-5":{"input":1.00,"output":5.00},"claude-haiku-4-5-20251001":{"input":1.00,"output":5.00},"claude-sonnet-5-5":{"input":2.00,"output":10.00},"claude-opus-5-5":{"input":4.00,"output":20.00},"claude-fable-5-1":{"input":10.00,"output":50.00}}

# URL de la API que usan los scripts de apoyo (scripts/); no necesita claves LLM.
ESTIMATOR_API_BASE_URL=http://localhost:8000

# --- Guardrails de entrada ---
# La moderación usa la API de OpenAI y se omite sin OPENAI_API_KEY.
MODERATION_ENABLED=true
MODERATION_MODEL=omni-moderation-latest
# true: si la moderación falla, la solicitud continúa; false: responde 503.
MODERATION_FAIL_OPEN=true

# --- Embeddings y caché semántica (requiere REDIS_URL hacia Redis Stack y OPENAI_API_KEY) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# off | log_only (consulta y registra, no devuelve aciertos) | active
SEMANTIC_CACHE_MODE=active
# Similitud coseno mínima (0-1) para considerar un acierto.
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=86400
# Por encima de este número de caracteres la caché semántica se omite (límite de tokens de los
# embeddings); la caché exacta sigue activa. Una transcripción de 80 000 caracteres la supera.
SEMANTIC_CACHE_MAX_CHARS=8000

# --- Sesiones conversacionales (en memoria del proceso; se pierden al reiniciar) ---
# Turnos (pares usuario+asistente) que conserva cada sesión.
SESSION_MAX_TURNS=6
# Segundos de inactividad tras los que caduca una sesión y número máximo de sesiones simultáneas.
SESSION_TTL_SECONDS=21600
SESSION_MAX_COUNT=200

# --- Validación de la salida estructurada ---
# Intentos totales (1 = sin corrección automática).
VALIDATION_MAX_ATTEMPTS=3

# --- Historial persistente (PostgreSQL) ---
# Sin valor, el historial queda desactivado. El Compose raíz lo configura solo.
# DATABASE_URL=postgresql+asyncpg://estimator:estimator-dev@localhost:5432/estimator
# Candidatos que explora el índice HNSW por búsqueda (1-1000): más = más recall y latencia. Ver docs/session-08-ef-search.md.
# HNSW_EF_SEARCH=40

# --- Memoria conversacional ampliada ---
# Los turnos que salen de la ventana se resumen (resumen acumulativo) y los que contienen compromisos
# (contratos, alcance cerrado, presupuesto acordado, fechas límite, restricciones legales) se conservan
# literalmente como anclas. heuristic: reglas locales sin coste; llm: una llamada al modelo (con las
# reglas como respaldo si falla).
ANCHOR_DETECTION_MODE=heuristic

# --- Modelo por tarea (opcional; sin valor, la tarea usa LLM_MODEL) ---
# ESTIMATOR_MODEL=gpt-4o
# METADATA_MODEL=gpt-4o-mini
# SUMMARY_MODEL=gpt-4o-mini
# CRITIC_MODEL=gpt-4o

# --- Audiencia ---
# Versión del prompt de estimación que usan las sesiones cuando la solicitud no envía prompt_version.
# v4 adapta el enfoque a la audiencia (executive, pm, developer, default); v3 es la versión anterior.
CONVERSATION_PROMPT_VERSION=v4

# --- Actor–Critic–Boss (POST /api/v1/sessions/{id}/estimate-acb) ---
# Máximo de generaciones del actor (1-5), contando la primera. El crítico usa CRITIC_MODEL.
BOSS_MAX_ITERATIONS=3

# --- Adjuntos ---
# Caracteres que se conservan del texto extraído de cada adjunto PDF/Word (el resto se recorta).
MAX_ATTACHMENT_CHARS=60000

# --- Ingesta de datos (sesión 6) ---
# Catálogo de fuentes y raíz del corpus; las rutas relativas se resuelven desde el directorio de trabajo (/app en Docker).
CATALOG_PATH=data/catalog/catalog.yaml
INGESTION_DATA_ROOT=data/seed
# Modelo spaCy español que usa Presidio (instalado en la imagen) y locale de Faker para los seudónimos.
PRESIDIO_SPACY_MODEL=es_core_news_md
PSEUDONYM_FAKER_LOCALE=es_ES
# Sal del HMAC-SHA256 con el que se identifican los valores originales. Cámbiala fuera de desarrollo:
# cambiarla invalida los mappings ya guardados (cada valor recibiría otro hash y otro seudónimo).
PSEUDONYM_HASH_SALT=change-me-in-prod

# Chunking (sesión 7): modelos de las estrategias que llaman a un LLM durante la ingesta.
# propositional usa un modelo de OpenAI; contextual_retrieval, uno de Anthropic (con prompt caching).
# PROPOSITIONAL_CHUNKER_MODEL=gpt-4o-mini
# CONTEXTUAL_CHUNKER_MODEL=claude-sonnet-4-5

# Modelos en runtime (sesión 7): catálogo seleccionable en PUT /api/v1/config/models (separado por comas).
# La API lo filtra por las claves de proveedor configuradas. Los overrides viven en Redis, no aquí.
# AVAILABLE_MODELS=gpt-4o-mini,gpt-4o,claude-haiku-4-5,claude-sonnet-4-5

# --- RAG de estimación fundamentada (Sesión 9: /v1/retrieval/* y /v1/estimate/*) ---
# Claves de API independientes (cabecera X-API-Key). Sin valor, el router correspondiente responde 401 a todo.
# RETRIEVAL_API_KEY=cambia-esta-clave-de-recuperacion
# ESTIMATE_API_KEY=cambia-esta-clave-de-estimacion
# Modelos de reformulación (transcripción -> brief) y de generación; sin valor, el modelo primario efectivo.
# REFORMULATION_MODEL=gpt-4o-mini
# GENERATION_MODEL=gpt-4o
# Chunks por consulta (1-30) y umbral de distancia coseno (0-2; menor = más parecido).
RETRIEVAL_TOP_K=10
RETRIEVAL_DISTANCE_THRESHOLD=0.6
# Tokens máximos del bloque de fuentes (se descartan chunks completos, nunca se parten).
MAX_CONTEXT_TOKENS=16384
# Segundos que se recuerda una estimación por idempotency_key (Redis con REDIS_URL; memoria sin él).
IDEMPOTENCY_TTL=86400

# --- Recuperación avanzada (Sesión 10) ---
# Modo de búsqueda por defecto: vector (Sesión 9) o hybrid (vectorial + léxica con RRF). Cambia en caliente con
# PUT /api/v1/config/retrieval; una petición puede fijarlo con `search_mode`.
RETRIEVAL_SEARCH_MODE=vector
# Reranking con cross-encoder (recall-then-rerank). El modelo se descarga en el primer uso; apagado nunca se carga.
RERANKER_ENABLED=false
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Candidatos que se recuperan antes de fusionar/reordenar y mejores que se devuelven tras el reranking.
RETRIEVAL_RECALL_TOP_K=50
RERANK_TOP_N=5
# Constante de suavizado de Reciprocal Rank Fusion.
RRF_K=60
# Etapas de POST /v1/retrieval/advanced-search: routing en cascada, transformación de consulta y decay temporal.
RETRIEVAL_ROUTING_ENABLED=true
QUERY_TRANSFORM_ENABLED=true
TEMPORAL_DECAY_ENABLED=false
# Vida media del decay en días (peso = 0.5 ** (edad / vida_media)) y topes de subconsultas y colecciones.
TEMPORAL_DECAY_HALF_LIFE_DAYS=900
QUERY_MAX_SUBQUERIES=4
ROUTER_MAX_TARGETS=3
# Modelos del clasificador del router y del transformador de consulta; sin valor, el modelo primario efectivo.
# ROUTER_MODEL=gpt-4o-mini
# QUERY_TRANSFORM_MODEL=gpt-4o-mini
# Horas por tarea (POST /v1/estimate/tasks/hours): vecinos históricos y distancia coseno máxima (0-2).
TASK_HOURS_TOP_K=5
TASK_HOURS_DISTANCE_THRESHOLD=0.45

# --- Calidad de la generación (Sesión 11): todo apagado por defecto; se conmuta en runtime en /api/v1/config/retrieval ---
# Gate de alucinaciones: ancla numérica (horas históricas de los chunks citados) + un juez LLM por estimación.
# Una línea que supera el ancla más de TOLERANCE (relativa: 0.5 = un 50 % más) o que el juez no respalda queda `degraded`
# y rebaja la confianza a `low`. Sin modelo del juez, se usa el modelo primario efectivo.
HALLUCINATION_GATE_ENABLED=false
HALLUCINATION_NUMERIC_TOLERANCE=0.5
# HALLUCINATION_JUDGE_MODEL=gpt-4o-mini
# Aumentación del contexto (sin LLM): compresión extractiva (líneas con cifras o ids) y reordenación de bordes.
# COMPRESS y REORDER solo actúan con AUGMENTATION_ENABLED=true.
AUGMENTATION_ENABLED=false
AUGMENTATION_COMPRESS=true
AUGMENTATION_REORDER=true
# Rango de horas ante vecinos contradictorios: dispersión (coeficiente de variación) a partir de la cual hay `hours_range`.
SYNTHESIS_ENABLED=false
SYNTHESIS_CONTRADICTION_THRESHOLD=0.35
# SYNTHESIS_MODEL=gpt-4o-mini
