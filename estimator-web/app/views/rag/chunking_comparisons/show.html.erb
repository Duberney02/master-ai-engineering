<% content_for :title, "Comparación · Chunking Lab" %>
<h1>Resultado de la comparación</h1>
<p class="meta">
  <% if @comparison.created_at %>Ejecutada el <%= format_time(@comparison.created_at.utc.iso8601) %> · <% end %>
  <%= @comparison.corpus_count %> presupuestos
  <% if @comparison.duration_seconds %> · <%= @comparison.duration_seconds %> s<% end %>
  · coste de ingesta <%= format_usd(@response.total_ingestion_cost_usd) %>
</p>
<p>
  <a href="<%= new_rag_chunking_comparison_path %>">← Nueva comparación</a> ·
  <a href="<%= rag_chunking_comparisons_path %>">Historial</a>
</p>

<section class="card" id="lab-stats">
  <h2>Estadísticas por estrategia</h2>
  <%= render "stats_table", response: @response %>
</section>

<section class="card" id="lab-cost">
  <h2>Coste de la ingesta</h2>
  <%= render "cost_bars", response: @response %>
</section>

<% if @response.any_queries? %>
  <section id="lab-playground">
    <h2>Recuperación por consulta</h2>
    <%= render "playground", response: @response %>
  </section>
<% else %>
  <div class="card" id="lab-no-queries">Esta ejecución no tuvo consultas: solo se calcularon las estadísticas.</div>
<% end %>
