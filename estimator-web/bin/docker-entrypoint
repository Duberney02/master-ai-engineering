#!/bin/sh
# Prepara la base de datos del historial (crea y migra) antes de servir. Sin DATABASE_URL no hace nada:
# el cliente funciona igual, solo que el Chunking Lab no podrá guardar sus ejecuciones.
set -e

if [ -n "$DATABASE_URL" ] && [ "$1" = "bin/rails" ] && [ "$2" = "server" ]; then
  bin/rails db:prepare
fi

exec "$@"
