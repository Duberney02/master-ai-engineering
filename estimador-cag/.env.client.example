# Configuración del CLIENTE Streamlit. No lleva claves de proveedores ni Redis.
# Exporta estas variables antes de `streamlit run streamlit_app.py` (Streamlit no lee .env).

# URL base de la API (en Docker Compose: http://api:8000).
ESTIMATOR_API_BASE_URL=http://localhost:8000
ESTIMATOR_API_CONNECT_TIMEOUT_SECONDS=5
# Máximo sin recibir datos; el servidor envía latidos SSE cada SSE_HEARTBEAT_SECONDS.
ESTIMATOR_API_READ_TIMEOUT_SECONDS=120
